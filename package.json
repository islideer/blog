    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.8.5",
    "dayjs": "^1.11.19",
    "feed": "^5.1.0",
    "gray-matter": "^4.0.3",
    "next": "^16.0.7",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "pangu": "^7.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-medium-image-zoom": "^5.4.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
