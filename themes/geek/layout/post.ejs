<div class="hd posts">
    <a href="/index.html"><i class="fa fa-reply replay-btn" aria-hidden="true"></i></a>
    <div class="post-title">
        <h4>
            <%= page.title %>
        </h4>
    </div>
    <hr>
    <div class="post-date">
        <%= full_date(page.date, 'YYYY/M/DD dddd') %>
    </div>
    <br />
    <div class="post-content">
        <%- page.content %>
    </div>
    <% if (page.comments) { %>
    <hr class="fhr">
    <h3>🙃留下你的影子？</h3>
    <div id="vcomments"></div>
    <% } %>
    <img src="https://i.loli.net/2020/03/23/UNG7ptiT4RyrgFz.png"
        style="display:block;margin:0 auto;border-radius: 8px;height:100px;" />
</div>