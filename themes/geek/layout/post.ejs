<div class="hd posts">
    <a href="/index.html"><i class="fa fa-reply replay-btn" aria-hidden="true"></i></a>
    <div class="post-title">
        <h4>
            <%= page.title %>
        </h4>
    </div>
    <hr>
    <div class="post-date">
        <%= full_date(page.date, 'YYYY-M-DD-MMM') %>
    </div>
    <br />
    <div class="post-content">
        <%- page.content %>
    </div>
    <% if (page.comments) { %>
    <hr class="fhr">
    <h3>🙃留下你来过的影子👇？</h3>
    <div id="vcomments"></div>
    <% } %>
    <img src="" />
</div>