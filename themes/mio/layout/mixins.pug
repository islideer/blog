mixin make_post(item, is_detail)
	.post.animated.fadeInDown
		.post-title
			if is_detail
				h1= item.title
			else
				h3
					a(href= url_for(item.path))= item.title
		if is_detail
			.post-content!= item.content
			if is_current('about')
				p
			else
				p(style="color: #bbb; margin:20px 0px 8px 0px;") The End.
		else
			.post-content
				- var summary = item.excerpt || item.summary || item.content
				p(style="opacity: 0.6")!= truncate(strip_html(summary), {length: 120})
		.post-footer: .meta
			.info
				if is_current('about')
					span
				else
					i.fa.fa-calendar-o
					span.date= date(item.date, 'YYYY-MM-DD')

mixin postList()
	.archive
		- var year = 0;
		- var change = false;
		- var firstYear = true;
		- page.posts.each(function (item) {
			- var itemYear = date(item.date, 'YYYY') - 0;
			- change = year !== itemYear;
			- year = change ? itemYear : year;
			if change
				if firstYear
					| <div class="listing-title">
					!= year
					| </div><ul class="listing">
					- firstYear = false;
				else
					| </ul><div class="listing-title">
					!= year
					| </div><ul class="listing">

			.listing-item
				.listing-post
					a(href= url_for(item.path), title= item.title)= item.title
					div.post-time
						span.date= date(item.date, 'MM-DD')
		- })
