.sidebar.animated.fadeInDown
  .logo-title
    .title
      - var src = "https://qqa.deno.dev/" + theme.accounts.qq;
      img(src= src)
      h3 #{config.title}
      if theme.description
        .description
          p!= theme.description
  ul.social-links
    if theme.accounts.github
      li
        - var href = "https://github.com/" + theme.accounts.github
        a(href=href)
          i.fa.fa-github
    if theme.accounts.mail
      li
        - var href = "mailto:" + theme.accounts.mail
        a(href=href)
          i.fa.fa-envelope
  include footer
