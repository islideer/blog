.page-top.animated.fadeInDown
  .nav
    li
      if is_home()
        a.current(href="/" style="font-weight: bold")= __('articles')
      else
        a(href="/")= __('articles')

    li
      if is_archive()
        a.current(href="/archives/" style="font-weight: bold")= __('archives')
      else
        a(href="/archives/")= __('archives')

    li
      if is_current('about')
        a.current(href="/about.html" style="font-weight: bold")= __('about')
      else
        a(href="/about.html")= __('about')

  .nav(style="float:right" onclick="window.history.back();")
    if is_post()
      li(style="float: right")
        a(href="#")= __('back')