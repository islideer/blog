{
  "css.customData": [".vscode/tailwind.json"],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "css.lint.unknownAtRules": "ignore",
  "cSpell.words": [
    "Chiikawa",
    "eventsource",
    "flexsearch",
    "keli",
    "rmiz",
    "stattrak",
    "Travellings",
    "unzoom"
  ],
  "markdown.validate.enabled": true
}
